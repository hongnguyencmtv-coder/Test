-- VÒNG LẶP DỊCH CHUYỂN NÉ QUÁI TỰ ĐỘNG
task.spawn(function()
    while task.wait(0.1) do
        pcall(function()
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")

            if hum then
                if getgenv().WalkSpeedEnabled then hum.WalkSpeed = getgenv().WalkSpeedValue end
                if getgenv().JumpPowerEnabled then 
                    hum.UseJumpPower = true
                    hum.JumpPower = getgenv().JumpPowerValue 
                end
            end

            -- LOGIC NÉ QUÁI TỰ ĐỘNG
            if getgenv().AutoEvadeMobs and hrp then
                local enemies = workspace:FindFirstChild("Enemies") or workspace
                for _, mob in ipairs(enemies:GetChildren()) do
                    local mobHrp = mob:FindFirstChild("HumanoidRootPart") or mob.PrimaryPart
                    local mobHum = mob:FindFirstChildOfClass("Humanoid")
                    
                    if mobHrp and mobHum and mobHum.Health > 0 and mob ~= char then
                        local dist = (mobHrp.Position - hrp.Position).Magnitude
                        -- Nếu quái tiến vào bán kính nguy hiểm, dịch chuyển ngay lên cao 35 studs để né
                        if dist <= getgenv().SafeDistance then
                            hrp.CFrame = hrp.CFrame * CFrame.new(0, 35, 0)
                            task.wait(0.2)
                        end
                    end
                end
            end

            -- LOGIC STEAL EGG
            if getgenv().AutoSteal and hrp then
                for _, obj in ipairs(workspace:GetDescendants()) do
                    if obj:IsA("BasePart") or obj:IsA("Model") then
                        local nameLower = obj.Name:lower()
                        if nameLower:find("egg") or nameLower:find("trung") then
                            local part = obj:IsA("BasePart") and obj or obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                            if part and (part.Position - hrp.Position).Magnitude < 150 then
                                firetouchinterest(hrp, part, 0)
                                task.wait(0.02)
                                firetouchinterest(hrp, part, 1)
                            end
                        end
                    end
                end
            end

            -- LOGIC DEPOSIT
            if getgenv().AutoDeposit and hrp then
                for _, base in ipairs(workspace:GetDescendants()) do
                    if base.Name:lower():find("nest") or base.Name:lower():find("deposit") or base.Name:lower():find("base") then
                        local part = base:IsA("BasePart") and base or base.PrimaryPart
                        if part then
                            firetouchinterest(hrp, part, 0)
                            task.wait(0.02)
                            firetouchinterest(hrp, part, 1)
                        end
                    end
                end
            end

        end)
    end
end)
