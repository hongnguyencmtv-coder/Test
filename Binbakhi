local function CreateTabButton(name, iconText)
    local btn = Instance.new("TextButton", Sidebar)
    btn.Size = UDim2.new(1, -15, 0, 36)
    btn.BackgroundColor3 = Color3.fromRGB(25, 30, 40)
    btn.BackgroundTransparency = 1
    btn.Text = "   " .. iconText .. "   " .. name
    btn.TextColor3 = Color3.fromRGB(160, 170, 185)
    btn.Font = Enum.Font.GothamMedium
    btn.TextSize = 12
    btn.TextXAlignment = Enum.TextXAlignment.Left
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    local page = Instance.new("ScrollingFrame", PageContainer)
    page.Size = UDim2.new(1, 0, 1, 0)
    page.BackgroundTransparency = 1
    page.Visible = false
    page.ScrollBarThickness = 2
    page.ScrollBarImageColor3 = Color3.fromRGB(60, 70, 90)

    local layout = Instance.new("UIListLayout", page)
    layout.Padding = UDim.new(0, 8)

    Pages[name] = page
    TabButtons[name] = btn

    btn.MouseButton1Click:Connect(function()
        for k, p in pairs(Pages) do p.Visible = false end
        for k, b in pairs(TabButtons) do 
            b.BackgroundTransparency = 1 
            b.TextColor3 = Color3.fromRGB(160, 170, 185)
        end
        page.Visible = true
        btn.BackgroundTransparency = 0.5
        btn.BackgroundColor3 = Color3.fromRGB(35, 42, 56)
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    end)

    return page
end

